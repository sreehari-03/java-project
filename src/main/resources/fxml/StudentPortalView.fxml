<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.srms.controller.StudentPortalController">
  <fx:define><ToggleGroup fx:id="navGroup"/></fx:define>

  <left>
    <VBox styleClass="sidebar" prefWidth="250" spacing="4">
      <Label text="📘  Result System" styleClass="side-brand"/>
      <Label fx:id="sideName" styleClass="side-sub" wrapText="true"/>
      <Region prefHeight="16"/>
      <ToggleButton fx:id="navDash" text="Dashboard" toggleGroup="$navGroup" styleClass="nav-btn" maxWidth="Infinity"/>
      <ToggleButton fx:id="navResults" text="My Results" toggleGroup="$navGroup" styleClass="nav-btn" maxWidth="Infinity"/>
      <ToggleButton fx:id="navCorrection" text="Request Correction" toggleGroup="$navGroup" styleClass="nav-btn" maxWidth="Infinity"/>
      <ToggleButton fx:id="navFocus" text="Request Extra Focus" toggleGroup="$navGroup" styleClass="nav-btn" maxWidth="Infinity"/>
      <ToggleButton fx:id="navProfile" text="Profile" toggleGroup="$navGroup" styleClass="nav-btn" maxWidth="Infinity"/>
      <Region VBox.vgrow="ALWAYS"/>
      <Button text="Logout" styleClass="nav-btn" maxWidth="Infinity" onAction="#onLogout"/>
    </VBox>
  </left>

  <center>
    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="page-scroll">
      <StackPane alignment="TOP_LEFT" styleClass="page-pad">

        <!-- DASHBOARD -->
        <VBox fx:id="dashPage" spacing="18" visible="false" managed="false">
          <HBox styleClass="profile-header" spacing="16" alignment="CENTER_LEFT">
            <Label fx:id="avatar" styleClass="avatar"/>
            <VBox spacing="2"><Label fx:id="dpName" styleClass="profile-name"/><Label fx:id="dpMeta" styleClass="profile-meta"/></VBox>
          </HBox>
          <HBox spacing="14">
            <Button text="📊  My Results&#10;View marks &amp; teacher remarks" styleClass="action-card" HBox.hgrow="ALWAYS" maxWidth="Infinity" onAction="#goResults"/>
            <Button text="✏  Request Correction&#10;Raise a clarification" styleClass="action-card" HBox.hgrow="ALWAYS" maxWidth="Infinity" onAction="#goCorrection"/>
            <Button text="🎯  Request Extra Focus&#10;Suggest topics for support" styleClass="action-card" HBox.hgrow="ALWAYS" maxWidth="Infinity" onAction="#goFocus"/>
          </HBox>
          <HBox spacing="18">
            <VBox styleClass="card" prefWidth="320" spacing="8" alignment="TOP_CENTER">
              <Label text="Overall Performance" styleClass="h3"/>
              <StackPane>
                <PieChart fx:id="donut" legendVisible="false" labelsVisible="false" animated="false" startAngle="90" prefWidth="240" prefHeight="240"/>
                <Circle radius="58" styleClass="donut-hole"/>
                <Label fx:id="donutLabel" styleClass="donut-text"/>
              </StackPane>
              <Label fx:id="donutCaption" styleClass="muted"/>
            </VBox>
            <VBox styleClass="card" HBox.hgrow="ALWAYS" spacing="8">
              <Label text="Recent Performance by Subject" styleClass="h3"/>
              <BarChart fx:id="subjectChart" legendVisible="false" animated="false" prefHeight="290">
                <xAxis><CategoryAxis side="BOTTOM"/></xAxis>
                <yAxis><NumberAxis side="LEFT" autoRanging="false" lowerBound="0" upperBound="100" tickUnit="20"/></yAxis>
              </BarChart>
            </VBox>
          </HBox>
        </VBox>

        <!-- RESULTS & REMARKS -->
        <VBox fx:id="resultsPage" spacing="14" visible="false" managed="false">
          <HBox alignment="CENTER_LEFT" spacing="10">
            <Label text="Results &amp; Remarks" styleClass="h1"/>
            <Region HBox.hgrow="ALWAYS"/>
            <ComboBox fx:id="termBox" prefWidth="170"/>
            <Button text="Submit Correction Request" styleClass="btn-peach" onAction="#goCorrection"/>
          </HBox>
          <TableView fx:id="resultTable" prefHeight="300"/>
          <VBox styleClass="card" spacing="6">
            <Label text="Teacher Remarks" styleClass="h3"/>
            <Label fx:id="remarkLabel" wrapText="true"/>
          </VBox>
        </VBox>

        <!-- REQUEST CORRECTION -->
        <VBox fx:id="correctionPage" spacing="14" visible="false" managed="false">
          <Label text="Request Correction" styleClass="h1"/>
          <VBox styleClass="card" spacing="8">
            <Label text="Subject" styleClass="field-label"/>
            <ComboBox fx:id="corrSubject" prefWidth="300"/>
            <Label text="What needs correction or clarification?" styleClass="field-label"/>
            <TextArea fx:id="corrText" prefRowCount="4" wrapText="true"/>
            <Button text="Submit Request" styleClass="btn-primary" onAction="#onSubmitCorrection"/>
          </VBox>
          <Label text="My Requests" styleClass="h3"/>
          <TableView fx:id="corrTable" prefHeight="240"/>
        </VBox>

        <!-- SPECIAL FOCUS -->
        <VBox fx:id="focusPage" spacing="14" visible="false" managed="false">
          <Label text="Request Extra Focus" styleClass="h1"/>
          <VBox styleClass="card" spacing="8">
            <HBox spacing="14">
              <VBox spacing="4" HBox.hgrow="ALWAYS"><Label text="Select Subject" styleClass="field-label"/><ComboBox fx:id="focusSubject" maxWidth="Infinity"/></VBox>
              <VBox spacing="4" HBox.hgrow="ALWAYS"><Label text="Topic / Area" styleClass="field-label"/><ComboBox fx:id="focusTopic" maxWidth="Infinity"/></VBox>
            </HBox>
            <Label text="Additional Comments / Specific Help Needed" styleClass="field-label"/>
            <TextArea fx:id="focusText" prefRowCount="4" wrapText="true"/>
            <Button text="Submit Request" styleClass="btn-primary" onAction="#onSubmitFocus"/>
          </VBox>
          <Label text="Past Requests" styleClass="h3"/>
          <TableView fx:id="focusTable" prefHeight="240"/>
        </VBox>

        <!-- PROFILE -->
        <VBox fx:id="profilePage" spacing="14" visible="false" managed="false">
          <Label text="Profile" styleClass="h1"/>
          <GridPane styleClass="card" hgap="24" vgap="12">
            <columnConstraints><ColumnConstraints minWidth="160"/><ColumnConstraints hgrow="ALWAYS"/></columnConstraints>
            <Label text="Full Name" styleClass="muted" GridPane.rowIndex="0"/><Label fx:id="profName" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
            <Label text="Registration No" styleClass="muted" GridPane.rowIndex="1"/><Label fx:id="profReg" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
            <Label text="Class" styleClass="muted" GridPane.rowIndex="2"/><Label fx:id="profClass" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
            <Label text="Email" styleClass="muted" GridPane.rowIndex="3"/><Label fx:id="profEmail" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
            <Label text="School" styleClass="muted" GridPane.rowIndex="4"/><Label fx:id="profSchool" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
          </GridPane>
        </VBox>

      </StackPane>
    </ScrollPane>
  </center>
</BorderPane>
