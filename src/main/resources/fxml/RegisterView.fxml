<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.srms.controller.RegisterController" styleClass="register-bg">
  <fx:define><ToggleGroup fx:id="accountGroup"/></fx:define>
  <ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" styleClass="auth-scroll">
    <content>
      <StackPane alignment="TOP_CENTER" style="-fx-padding: 12 0 12 0;">
  <VBox styleClass="card, register-card" maxWidth="560" maxHeight="-Infinity" spacing="5">
    <Button text="← Back to login" styleClass="back-link" onAction="#onLogin" alignment="CENTER_LEFT"/>
    <HBox alignment="CENTER" spacing="8" styleClass="register-brand">
      <Label text="🎓" styleClass="register-cap"/>
      <VBox spacing="0">
        <Label text="Student Result" styleClass="register-brand-title"/>
        <Label text="Management System" styleClass="register-brand-subtitle"/>
      </VBox>
    </HBox>
    <VBox alignment="CENTER" spacing="2" styleClass="register-heading">
      <Label text="Create Account" styleClass="h1"/>
      <Label text="Join the Student Result Management System" styleClass="muted"/>
    </VBox>

    <GridPane hgap="14" vgap="0" style="-fx-padding: 4 0 0 0;">
      <columnConstraints>
        <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
        <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
      </columnConstraints>

      <VBox GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="0">
        <Label text="School Name" styleClass="field-label"/>
        <HBox styleClass="input-box"><Label text="🏫"/><TextField fx:id="schoolField" promptText="Enter your school name" HBox.hgrow="ALWAYS"/></HBox>
      </VBox>
      <VBox GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="1">
        <Label text="Registration Number" styleClass="field-label"/>
        <HBox styleClass="input-box"><Label text="🪪"/><TextField fx:id="regField" promptText="Enter your registration number" HBox.hgrow="ALWAYS"/></HBox>
      </VBox>

      <VBox GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="2">
        <Label text="Full Name" styleClass="field-label"/>
        <HBox styleClass="input-box"><Label text="👤"/><TextField fx:id="nameField" promptText="Enter your full name" HBox.hgrow="ALWAYS"/></HBox>
      </VBox>
      <VBox GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="3">
        <Label text="Class (students)" styleClass="field-label"/>
        <HBox styleClass="input-box"><Label text="📖"/><TextField fx:id="classField" promptText="e.g. 10-A" HBox.hgrow="ALWAYS"/></HBox>
      </VBox>

      <VBox GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="4">
        <Label text="Username" styleClass="field-label"/>
        <HBox styleClass="input-box"><Label text="👤"/><TextField fx:id="usernameField" promptText="Choose a unique username" HBox.hgrow="ALWAYS"/></HBox>
      </VBox>
      <VBox GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="5">
        <Label text="Email Address" styleClass="field-label"/>
        <HBox styleClass="input-box"><Label text="✉"/><TextField fx:id="emailField" promptText="Enter your email address" HBox.hgrow="ALWAYS"/></HBox>
      </VBox>

      <VBox GridPane.columnIndex="0" GridPane.rowIndex="6">
        <Label text="Password" styleClass="field-label"/>
        <HBox styleClass="input-box"><Label text="🔒"/><PasswordField fx:id="passField" HBox.hgrow="ALWAYS"/></HBox>
      </VBox>
      <VBox GridPane.columnIndex="1" GridPane.rowIndex="6">
        <Label text="Confirm Password" styleClass="field-label"/>
        <HBox styleClass="input-box"><Label text="🔒"/><PasswordField fx:id="confirmField" HBox.hgrow="ALWAYS"/></HBox>
      </VBox>
    </GridPane>

    <Label text="Are you a teacher / admin?" styleClass="field-label"/>
    <HBox styleClass="seg">
      <ToggleButton text="Student" toggleGroup="$accountGroup" selected="true" styleClass="seg-btn" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
      <ToggleButton fx:id="teacherTog" text="Teacher" toggleGroup="$accountGroup" styleClass="seg-btn" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
    </HBox>

    <CheckBox fx:id="termsCheck" text="I agree to the Terms &amp; Conditions" style="-fx-padding: 10 0 6 0;"/>
    <Button text="Create Account →" styleClass="btn-primary" maxWidth="Infinity" defaultButton="true" onAction="#onCreate"/>
    <Label fx:id="errorLabel" styleClass="error-label"/>
    <HBox alignment="CENTER">
      <Label text="Already have an account?" styleClass="muted"/>
      <Hyperlink text="Log In" styleClass="link" onAction="#onLogin"/>
    </HBox>
  </VBox>
      </StackPane>
    </content>
  </ScrollPane>
</StackPane>
